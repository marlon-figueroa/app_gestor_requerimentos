# Imágenes del sistema:
#   target "app": PHP-FPM con el código, dependencias de Composer y assets compilados.
#   target "web": Nginx con los archivos públicos; envía PHP al contenedor app.

ARG PHP_VERSION=8.4
ARG NODE_VERSION=22
ARG NGINX_VERSION=1.28

# Assets de Vite (Bootstrap, DataTables, Select2, iconos, etc.)
FROM docker.io/library/node:${NODE_VERSION}-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY vite.config.js ./
COPY resources ./resources
COPY public ./public
RUN npm run build

# PHP-FPM con las extensiones que requiere Laravel, dompdf y MySQL
FROM docker.io/library/php:${PHP_VERSION}-fpm-alpine AS app
COPY --from=docker.io/mlocati/php-extension-installer:2 /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions bcmath exif gd intl opcache pcntl pdo_mysql zip \
    && apk add --no-cache su-exec
COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/local/bin/composer

COPY podman/php/php.ini $PHP_INI_DIR/conf.d/zz-app.ini
COPY podman/php/www.conf /usr/local/etc/php-fpm.d/zz-app.conf
COPY --chmod=755 podman/php/entrypoint.sh /usr/local/bin/app-entrypoint

WORKDIR /var/www/html

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress

COPY . .
COPY --from=assets /app/public/build ./public/build

RUN composer dump-autoload --optimize --no-dev --no-interaction \
    && mkdir -p storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && php artisan storage:link \
    && chown -R www-data:www-data storage bootstrap/cache

ENTRYPOINT ["app-entrypoint"]
CMD ["php-fpm"]

# Nginx: sirve estáticos y reenvía /index.php a app:9000
FROM docker.io/library/nginx:${NGINX_VERSION}-alpine AS web
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
COPY podman/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=app /var/www/html/public /var/www/html/public
