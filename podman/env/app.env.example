# Variables del contenedor "app" (Laravel). Copiar a podman/env/app.env
# o ejecutar podman/setup.sh, que genera APP_KEY y contraseñas.

APP_NAME="Gestor de Requerimientos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

# Al arrancar: migraciones y seeders (idempotentes: roles, permisos y admin).
APP_RUN_MIGRATIONS=true
APP_RUN_SEEDERS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Debe coincidir con podman/env/mysql.env
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app_gestor_requerimentos
DB_USERNAME=gestor
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Gestor de Requerimientos"
